{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "scripts",
    "outDir": "dist-tools",
    "strict": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/architecture-rules.ts",
    "scripts/verify-architecture.ts"
  ]
}
