{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ngdynamic/codeline-v2.schema.json",
  "title": "ngDynamic CodeLine v2 Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "language",
    "title",
    "description",
    "lines",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "enum": [
        "javascript",
        "typescript"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/codeLine"
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "edges"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "description": "Szerzői generátor metaadatai, az értékelés ezt nem használja.",
      "properties": {
        "strategy": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "codeLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "dependencies",
        "fixed",
        "functionBlock",
        "scopeId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "maxLength": 2048
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "fixed": {
          "type": "boolean"
        },
        "functionBlock": {
          "type": "integer",
          "minimum": 0
        },
        "scopeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "normalization": {
          "enum": [
            "indent",
            "exact"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "parentScopeId",
        "openLineId",
        "closeLineId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "function",
            "block"
          ]
        },
        "functionBlock": {
          "type": "integer",
          "minimum": 1
        },
        "parentScopeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "openLineId": {
          "type": "integer",
          "minimum": 1
        },
        "closeLineId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 1
        },
        "after": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
