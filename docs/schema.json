{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://philofobreal.github.io/developer-exercise/schema.json",
  "title": "ngDynamic CodeLine v2 Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "language",
    "title",
    "description",
    "lines",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "language": {
      "enum": [
        "javascript",
        "typescript"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/codeLine"
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 5000
    },
    "profiles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "edges"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            },
            "maxItems": 5000
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "maxLength": 100
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "omittedBlocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "semanticEquivalenceProven": {
          "const": false
        },
        "dependencyHints": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "declarationLine",
              "usageLine"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 2048
              },
              "declarationLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50000
              },
              "usageLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50000
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after",
              "category",
              "code"
            ],
            "properties": {
              "before": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "after": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "category": {
                "type": "string",
                "enum": [
                  "data",
                  "effect",
                  "structure",
                  "unit",
                  "policy",
                  "author",
                  "conservative",
                  "unknown"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                "maxLength": 64
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceDigest",
            "analyzer",
            "environment"
          ],
          "properties": {
            "sourceDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "analyzer": {
              "$ref": "#/$defs/dependencyPolicy"
            },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "typescript": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z.+-]{1,40}$"
                },
                "importEmit": {
                  "type": "string",
                  "enum": [
                    "verbatim",
                    "elide-unused"
                  ]
                },
                "sourceKind": {
                  "type": "string",
                  "enum": [
                    "module",
                    "script"
                  ]
                },
                "classFields": {
                  "const": "either"
                }
              }
            },
            "projectionLoss": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pairs",
                "examples"
              ],
              "properties": {
                "pairs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 125000
                },
                "examples": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/$defs/edge"
                  }
                }
              }
            }
          }
        },
        "ruleNotes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after",
              "note"
            ],
            "properties": {
              "before": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "after": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "relaxations": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after",
              "editability"
            ],
            "properties": {
              "before": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "after": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "editability": {
                "type": "string",
                "enum": [
                  "conservative",
                  "proven",
                  "legacy"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "removed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "origins",
                  "reasons"
                ],
                "properties": {
                  "origins": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "dependency",
                        "edge"
                      ]
                    }
                  },
                  "reasons": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "category",
                        "code"
                      ],
                      "properties": {
                        "category": {
                          "type": "string",
                          "enum": [
                            "data",
                            "effect",
                            "structure",
                            "unit",
                            "policy",
                            "author",
                            "conservative",
                            "unknown"
                          ]
                        },
                        "code": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                          "maxLength": 64
                        }
                      }
                    }
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "dependencyPolicy": {
          "$ref": "#/$defs/dependencyPolicy"
        }
      }
    }
  },
  "$defs": {
    "codeLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "dependencies",
        "fixed",
        "functionBlock",
        "scopeId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Stable identity within this exercise revision; never the current solution position."
        },
        "code": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[^\\r\\n\\u2028\\u2029]*$"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 500,
          "description": "IDs of all required predecessors. Each must occur earlier, at any distance; array order is irrelevant."
        },
        "fixed": {
          "type": "boolean"
        },
        "functionBlock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scopeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "normalization": {
          "enum": [
            "indent",
            "exact"
          ]
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "description": "Optional one-based original physical source line; informational, never an identity or ordering constraint."
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "parentScopeId",
        "openLineId",
        "closeLineId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "function",
            "block"
          ]
        },
        "functionBlock": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parentScopeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "openLineId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "closeLineId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "anyOf": [
        {
          "properties": {
            "kind": {
              "const": "function"
            },
            "functionBlock": {}
          },
          "required": [
            "functionBlock"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "block"
            }
          },
          "not": {
            "required": [
              "functionBlock"
            ],
            "properties": {
              "functionBlock": {}
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "dependencyPolicy": {
      "type": "string",
      "enum": [
        "primitive-const-islands-v1",
        "scoped-primitive-dag-v2",
        "scoped-type-members-v3",
        "scoped-effect-analysis-v4",
        "scoped-effect-analysis-v5",
        "scoped-effect-analysis-v6",
        "scoped-effect-analysis-v7",
        "scoped-effect-analysis-v8",
        "scoped-effect-analysis-v9",
        "scoped-effect-analysis-v10",
        "scoped-effect-analysis-v11",
        "scoped-effect-analysis-v12"
      ]
    }
  }
}
