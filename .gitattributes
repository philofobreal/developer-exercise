# Line endings: LF in the repository AND in every working tree, on all platforms.
#
# The build (tsc → public/app and dist, scripts/sync-vendor.mjs → public/vendor,
# the TypeScript sample catalog) always writes LF. Without this file a Windows
# checkout with core.autocrlf=true wrote CRLF, so every build showed unchanged
# generated files as "modified". `eol=lf` overrides core.autocrlf per file.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
